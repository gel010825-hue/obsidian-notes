# Obsidian
# === 工作区状态（频繁变动，不追踪）===
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/hotkeys.json

# === 插件 ===
# 忽略所有插件目录…
.obsidian/plugins/*
# …但追踪 obsidian-git（跨设备同步必需）
!.obsidian/plugins/obsidian-git
# obsidian-git 源码/构建产物不追踪
.obsidian/plugins/obsidian-git/src/
.obsidian/plugins/obsidian-git/node_modules/
.obsidian/plugins/obsidian-git/package.json
.obsidian/plugins/obsidian-git/package-lock.json
.obsidian/plugins/obsidian-git/tsconfig.json
.obsidian/plugins/obsidian-git/esbuild.config.mjs
.obsidian/plugins/obsidian-git/.gitignore
.obsidian/plugins/obsidian-git/README.md
.obsidian/plugins/obsidian-git/LICENSE
.obsidian/plugins/obsidian-git/CHANGELOG.md

# === 主题 ===
.obsidian/themes/

# === 回收站 ===
.trash/

# === 系统文件 ===
.DS_Store
Thumbs.db
desktop.ini

# === 临时文件 ===
*.tmp
*~
~$*

# === 附件过大警告 ===
# 如需追踪图片，建议设置 git-lfs
